#!/bin/sh
# Launch the widget from the project folder, e.g.  bin/claude-session-bots --demo
#
# gtk4-layer-shell must be loaded before GTK connects to Wayland, otherwise GTK
# reports "not supported" and the widget runs as a normal window. The library is
# looked up by csb/compat.py (Fedora and Debian/Ubuntu paths, then ldconfig).
HERE="$(cd "$(dirname "$0")/.." && pwd)"
cd "$HERE" || exit 1
PY="$HERE/.venv/bin/python3"
[ -x "$PY" ] || PY=python3

no_layer=0
for arg in "$@"; do
  [ "$arg" = "--no-layer-shell" ] && no_layer=1
done

if [ -z "$LD_PRELOAD" ]; then
  LIB=$(PYTHONPATH="$HERE" python3 -m csb.compat --find-layer-shell 2>/dev/null)
  if [ -n "$LIB" ]; then
    export LD_PRELOAD="$LIB"
  elif [ "$no_layer" = 0 ]; then
    cat >&2 <<MSG
claude-session-bots: gtk4-layer-shell is not installed, so the widget runs as a normal window.
  Corner placement needs it. GNOME does not support layer-shell, so a normal window is expected there.
  Fedora:        sudo dnf install gtk4-layer-shell
  Ubuntu 24.10+: sudo apt install libgtk4-layer-shell0 gir1.2-gtk4layershell-1.0
MSG
  fi
fi
exec "$PY" -m csb "$@"
